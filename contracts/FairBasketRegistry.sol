pragma solidity ^0.8.24;

/// @title FairBasketRegistry
/// @notice Anchors hashes of community procurement evidence for public auditability.
/// @dev This contract never holds donations, tokens or purchasing funds.
///      Do not submit personal data or unredacted receipts to public storage.
contract FairBasketRegistry {
    struct Campaign {
        address creator;
        bytes32 nameHash;
        uint256 budgetCapCents;
        uint32 targetUnits;
        uint64 createdAt;
        bool exists;
    }

    mapping(bytes32 => Campaign) private campaigns;
    mapping(bytes32 => mapping(bytes32 => bool)) public evidenceRecorded;

    event CampaignRegistered(
        bytes32 indexed campaignId,
        address indexed creator,
        bytes32 indexed nameHash,
        uint256 budgetCapCents,
        uint32 targetUnits,
        uint64 createdAt
    );

    event EvidenceRecorded(
        bytes32 indexed campaignId,
        address indexed recorder,
        bytes32 indexed evidenceHash,
        uint8 evidenceType,
        uint256 amountCents,
        uint64 timestamp
    );

    error InvalidCampaignId();
    error CampaignAlreadyExists();
    error CampaignNotFound();
    error NotCampaignCreator();
    error InvalidEvidenceHash();
    error InvalidEvidenceType();
    error DuplicateEvidence();

    /// @param campaignId Deterministic bytes32 campaign key generated by the client.
    /// @param nameHash Hash of the public/display name; do not put PII in it.
    /// @param budgetCapCents Declared ceiling in cents, not a deposit or verified spend.
    /// @param targetUnits Intended units, such as essential-goods kits.
    function registerCampaign(
        bytes32 campaignId,
        bytes32 nameHash,
        uint256 budgetCapCents,
        uint32 targetUnits
    ) external {
        if (campaignId == bytes32(0) || nameHash == bytes32(0) || budgetCapCents == 0 || targetUnits == 0) {
            revert InvalidCampaignId();
        }
        if (campaigns[campaignId].exists) revert CampaignAlreadyExists();

        campaigns[campaignId] = Campaign({
            creator: msg.sender,
            nameHash: nameHash,
            budgetCapCents: budgetCapCents,
            targetUnits: targetUnits,
            createdAt: uint64(block.timestamp),
            exists: true
        });

        emit CampaignRegistered(
            campaignId,
            msg.sender,
            nameHash,
            budgetCapCents,
            targetUnits,
            uint64(block.timestamp)
        );
    }

    /// @notice Anchor one evidence digest. Type: 0=quote, 1=budget snapshot,
    /// 2=purchase evidence, 3=delivery evidence. Declared amounts are not validated.
    function recordEvidence(
        bytes32 campaignId,
        bytes32 evidenceHash,
        uint8 evidenceType,
        uint256 amountCents
    ) external {
        Campaign storage campaign = campaigns[campaignId];
        if (!campaign.exists) revert CampaignNotFound();
        if (campaign.creator != msg.sender) revert NotCampaignCreator();
        if (evidenceHash == bytes32(0)) revert InvalidEvidenceHash();
        if (evidenceType > 3) revert InvalidEvidenceType();
        if (evidenceRecorded[campaignId][evidenceHash]) revert DuplicateEvidence();

        evidenceRecorded[campaignId][evidenceHash] = true;
        emit EvidenceRecorded(
            campaignId,
            msg.sender,
            evidenceHash,
            evidenceType,
            amountCents,
            uint64(block.timestamp)
        );
    }

    function campaignExists(bytes32 campaignId) external view returns (bool) {
        return campaigns[campaignId].exists;
    }

    function campaignCreator(bytes32 campaignId) external view returns (address) {
        return campaigns[campaignId].creator;
    }

    function getCampaign(bytes32 campaignId) external view returns (
        address creator,
        bytes32 nameHash,
        uint256 budgetCapCents,
        uint32 targetUnits,
        uint64 createdAt,
        bool exists
    ) {
        Campaign storage campaign = campaigns[campaignId];
        return (
            campaign.creator,
            campaign.nameHash,
            campaign.budgetCapCents,
            campaign.targetUnits,
            campaign.createdAt,
            campaign.exists
        );
    }
}